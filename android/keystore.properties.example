# Copy this to keystore.properties (git-ignored) and fill in real values.
# keystore.properties itself must never be committed -- it holds the
# release signing password. See ~/.android-keystores/deepxi/ for the
# actual keystore file + generated passwords (outside this repo on
# purpose).
storeFile=/home/seerish/.android-keystores/deepxi/deepxi-release.jks
storePassword=REPLACE_ME
keyAlias=deepxi-release
keyPassword=REPLACE_ME
