<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-build-only override, merged on top of src/main/AndroidManifest.xml:
         instrumented tests serve local HTML via MockWebServer over plain
         HTTP to a real WebView, which Android blocks by default from API
         28+. Not applied to release builds. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
